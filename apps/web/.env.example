# Server-only variables. Configure separate values for Netlify Deploy Previews.
MONEY_ENV=development
MONEY_AUTH_MODE=private
RESEARCH_API_URL=http://localhost:8000
RESEARCH_API_TOKEN=
# At least 16 characters; set a strong unique workspace password.
MONEY_WEB_PASSWORD=
# At least 32 random characters; rotating this revokes sessions.
SESSION_SECRET=
