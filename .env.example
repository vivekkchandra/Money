# Local Compose only. Generate unique values; never commit .env.
# Use URL-safe characters for POSTGRES_PASSWORD (or URL-encode it in DATABASE_URL).
POSTGRES_PASSWORD=
RESEARCH_API_TOKEN=
MONEY_ENV=development
MONEY_RESEARCH_MODE=demo
# Host-side Python commands use this; Compose supplies its own postgres hostname.
DATABASE_URL=postgresql+psycopg://money:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/money

# Put these server-only values in apps/web/.env.local for Next.js development.
RESEARCH_API_URL=http://127.0.0.1:8000
MONEY_WEB_PASSWORD=
SESSION_SECRET=

# Qualified compute integrations ONLY; never put these in Netlify/browser settings.
# Production requires MONEY_RESEARCH_MODE=live and docs/LIVE_CONFIGURATION.md.
# MONEY_LIVE_MANIFEST=/run/money-qualified/manifest.json
# MONEY_LIVE_MANIFEST_SHA256=<sha256 of reviewed manifest bytes>
# EODHD_API_KEY=
# COMPANIES_HOUSE_API_KEY=
# MONEY_INFERENCE_API_KEY=  # name selected explicitly in the reviewed manifest
# TRADING212_METADATA_API_KEY=  # optional read-only metadata; NOT ISA proof
# TRADING212_METADATA_API_SECRET=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Commercial SaaS (server-only). Keep private defaults above only for legacy local use.
# Set MONEY_AUTH_MODE=saas on API and web to enable customer authentication.
# MONEY_EMAIL_ENCRYPTION_KEY=<Fernet key from your secret manager; never commit>
# MONEY_PUBLIC_WEB_URL=https://neon-griffin-08e616.netlify.app
# MONEY_ACCOUNT_SESSION_HOURS=12
# MONEY_REFERENCE_DATA_DIR=/app/data
# MONEY_ENABLE_SYNTHETIC_DEMO=true
# Development/test only; production/preview reject this flag. Never enables live research.

# Reviewed offboarding: no legal retention period is assumed.
# MONEY_RETENTION_APPROVED=false
# MONEY_RETENTION_POLICY_VERSION=<approved-policy-version>
# MONEY_RETENTION_APPROVAL_REFERENCE=<approval-record-reference>
# MONEY_PII_RETENTION_DAYS=<approved-explicit-number-of-days>
# MONEY_SMTP_HOST=<transactional SMTP host>
# MONEY_SMTP_PORT=465
# MONEY_SMTP_TLS=implicit
# MONEY_SMTP_USERNAME=<SMTP username>
# MONEY_SMTP_PASSWORD=<SMTP password>
# MONEY_EMAIL_FROM=<verified sender email>
# MONEY_BILLING_ENABLED=false
# MONEY_STRIPE_SECRET_KEY=<Stripe secret key>
# MONEY_STRIPE_WEBHOOK_SECRET=<Stripe endpoint signing secret>
# MONEY_STRIPE_API_VERSION=2025-03-31.basil
# MONEY_STRIPE_LIVE=false
# MONEY_STRIPE_PRICES={"PRO":"price_configured_pro","TEAM":"price_configured_team"}
# MONEY_INTERNAL_ADMIN_USER_IDS=["<existing internal administrator user UUID>"]
# MONEY_USER_JOBS_PER_MONTH=300
