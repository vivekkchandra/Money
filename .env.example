# Local Compose only. Generate unique values; never commit .env.
# Use URL-safe characters for POSTGRES_PASSWORD (or URL-encode it in DATABASE_URL).
POSTGRES_PASSWORD=
RESEARCH_API_TOKEN=
MONEY_ENV=development
MONEY_RESEARCH_MODE=demo
# Host-side Python commands use this; Compose supplies its own postgres hostname.
DATABASE_URL=postgresql+psycopg://money:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/money

# Put these server-only values in apps/web/.env.local for Next.js development.
RESEARCH_API_URL=http://127.0.0.1:8000
MONEY_WEB_PASSWORD=
SESSION_SECRET=

# Future qualified compute integrations only; none belongs in apps/web/browser code.
# OPENAI_API_KEY=
# MARKET_DATA_API_KEY=
# NEWS_API_KEY=
# COMPANIES_HOUSE_API_KEY=
# TRADING212_API_KEY=  # only if a verified eligibility source requires it
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
